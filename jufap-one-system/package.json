{
  "name": "jufap-one-system",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma central de inteligência gerencial da JUFAP",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "tsx --test tests/**/*.test.ts",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/run-sql.mjs database/migrations/0001_init.sql",
    "db:seed": "node scripts/run-sql.mjs database/seeds/0001_dev.sql",
    "pbi:audit": "python tools/pbi-audit/scan_pbip.py",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
