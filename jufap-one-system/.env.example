# Aplicação
NODE_ENV=development
DATA_MODE=mock
API_PORT=4000
WEB_PORT=3000
WEB_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Banco e fila
DATABASE_URL=postgres://jufap_one:jufap_one@localhost:5432/jufap_one
REDIS_URL=redis://localhost:6379

# Autenticação — será ativada na etapa 2
AUTH_MODE=mock
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback/entra-id

# OneDrive / SharePoint — será preenchido na etapa 2
ONEDRIVE_MODE=disabled
ONEDRIVE_TENANT_HOST=
ONEDRIVE_SITE_ID=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ROOT_PATH=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Power BI incorporado — etapa posterior
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

# JUFAP Brief — canal de envio será definido posteriormente
BRIEF_MODE=stdout
BRIEF_FROM=
