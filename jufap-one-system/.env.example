# Aplicação
NODE_ENV=development
DATA_MODE=mock
API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Banco e fila
DATABASE_URL=postgres://jufap_one:jufap_one@localhost:5432/jufap_one
REDIS_URL=redis://localhost:6379

# Autenticação — preparada para Microsoft Entra ID
AUTH_MODE=mock
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback/entra-id

# Ingestão — permanece desabilitada até a etapa 2
INGESTION_MODE=disabled
SOURCE_CONFIG_PATH=config/sources.stage2.example.json
SOURCE_CODE=
LOCAL_SOURCE_ROOT=./local-sources
MAX_SOURCE_FILE_BYTES=250000000

# OneDrive / SharePoint via Microsoft Graph — preencher na etapa 2
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=

# Sincronização e reconciliação de métricas
METRICS_MODE=disabled
RECONCILIATION_INPUT=

# Power BI incorporado — etapa posterior
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

# JUFAP Brief
BRIEF_MODE=disabled
BRIEF_PERIOD=today
BRIEF_SCOPE_TYPE=group
BRIEF_SCOPE_ID=
BRIEF_WEBHOOK_URL=
BRIEF_FROM=
